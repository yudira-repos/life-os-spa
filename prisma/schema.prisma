// LifeOS Platform — minimal V1 schema.
// Deliberately small: no Product/Plan/Subscription/UsageLimit tables yet.
// Entitlement is a plain boolean per household per module — that's the
// whole "licensing model" for now, on purpose. See DESIGN.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  ownedHouseholds Household[]       @relation("HouseholdOwner")
  memberships     HouseholdMember[]
}

model Household {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("FREE")
  ownerId   String
  createdAt DateTime @default(now())

  owner        User              @relation("HouseholdOwner", fields: [ownerId], references: [id])
  members      HouseholdMember[]
  entitlements Entitlement[]

  // FinancialOS
  financialProfile        FinancialProfile?
  plaidItems              PlaidItem[]
  accounts                FinancialAccount[]
  transactions            Transaction[]
  categoryRules           CategoryRule[]
  savingsGoals            SavingsGoal[]
  insurancePolicies       InsurancePolicy[]
  recommendationSnapshots RecommendationSnapshot[]
  financialAuditLogs      FinancialAuditLog[]

  // TravelOS
  travelPreferences TravelPreferences?
  schoolCalendars   SchoolCalendar[]
  blackoutPeriods   BlackoutPeriod[]
  travelWindows     TravelWindow[]
  trips             Trip[]

  // PropertyOS
  properties       Property[]
  propertyBills    PropertyBill[]
  maintenanceTasks MaintenanceTask[]
  vendors          Vendor[]
  equipment        Equipment[]

  // DayOS
  dayPreferences     DayPreferences?
  places             Place[]
  contacts           ExternalContact[]
  coordinationGroups CoordinationGroup[]
  rotations          Rotation[]
  activities         Activity[]
  occurrences        ActivityOccurrence[]
  travelEstimates    TravelEstimate[]
}

enum Role {
  OWNER
  ADULT
  CHILD
  GUEST
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String? // null for members without their own login (e.g. young kids)
  name        String
  role        Role
  birthdate   DateTime?
  createdAt   DateTime  @default(now())

  // KidsOS (Studies) profile — only meaningful for role CHILD. Grade drives
  // which curriculum concepts show up (KidsOS is scoped to grades 3-6, same
  // as the real lifeos-kids product); interests is free text used to flavor
  // word-problem wording and career suggestions.
  grade     Int?
  interests String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  masteries        Mastery[]
  practiceSessions PracticeSession[]
  pointsEntries    PointsEntry[]
  streak           Streak?
  badges           EarnedBadge[]
  activities       ChildActivity[]
  careerInterests  ChildCareerInterest[]

  // FinancialOS — adults only in practice; a CHILD member can be the *subject*
  // of an education goal without ever being able to read financial data.
  earnerProfile     EarnerProfile?
  ownedAccounts     FinancialAccount[] @relation("AccountOwner")
  goalsFor          SavingsGoal[]      @relation("GoalForMember")
  insurancePolicies InsurancePolicy[]  @relation("PolicyMember")

  // TravelOS
  schoolCalendars    SchoolCalendarChild[] @relation("CalendarChild")
  travelAvailability TravelAvailability?   @relation("TravelAvailability")
  blackoutPeriods    BlackoutPeriod[]      @relation("BlackoutMember")

  // DayOS
  dayProfile             MemberDayProfile?
  channels               MemberChannel[]
  notificationPrefs      MemberNotificationPrefs?
  groupMemberships       CoordinationGroupMember[]
  rotationSlots          RotationSlot[]
  activitiesAsSubject    Activity[]           @relation("ActivitySubject")
  activitiesAsDefault    Activity[]           @relation("ActivityDefaultResponsible")
  occurrencesResponsible ActivityOccurrence[] @relation("OccurrenceResponsible")
  overridesAssigned      AssignmentOverride[] @relation("OverrideAssignee")
  overridesReplaced      AssignmentOverride[] @relation("OverrideReplaced")
}

// --- KidsOS: Studies (mastery, practice, gamification) ---------------------
// Faithfully mirrors the shape of the real lifeos-kids product (mastery as a
// 0-1 moving average per concept, points/streaks/badges) but deliberately
// leaves out its billing, real-money rewards, diagnostics, and district/admin
// machinery — none of that belongs in a household platform. See DESIGN.md.

model Mastery {
  id          String   @id @default(cuid())
  childId     String
  subject     String
  conceptCode String
  level       Float    @default(0)
  attempts    Int      @default(0)
  updatedAt   DateTime @updatedAt

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, conceptCode])
}

model PracticeSession {
  id          String   @id @default(cuid())
  childId     String
  subject     String
  conceptCode String
  correct     Int
  total       Int
  passed      Boolean
  createdAt   DateTime @default(now())

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model PointsEntry {
  id        String   @id @default(cuid())
  childId   String
  reason    String
  points    Int
  createdAt DateTime @default(now())

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Streak {
  id            String    @id @default(cuid())
  childId       String    @unique
  currentDays   Int       @default(0)
  longestDays   Int       @default(0)
  lastActive    DateTime?
  bonusPaidWeek String?

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model EarnedBadge {
  id       String   @id @default(cuid())
  childId  String
  badgeKey String
  earnedAt DateTime @default(now())

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, badgeKey])
}

// --- KidsOS: Activities & Career Paths --------------------------------------
// Confirmed absent from the real lifeos-kids product (which only has a free
// text `interests` field) — these are net-new, built to round out the
// "studies, activities, interests, career paths" ask. Catalogs themselves are
// static content in src/lib/kidsos/; these tables just track a child's status
// against a catalog entry.

model ChildActivity {
  id          String   @id @default(cuid())
  childId     String
  activityKey String
  status      String // INTERESTED | ACTIVE
  addedAt     DateTime @default(now())

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, activityKey])
}

model ChildCareerInterest {
  id        String   @id @default(cuid())
  childId   String
  careerKey String
  addedAt   DateTime @default(now())

  child HouseholdMember @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, careerKey])
}

// One row per (household, module). No enabled row = not entitled.
// Seeded on household creation: kids + fun = true, everything else absent/false.
model Entitlement {
  id          String   @id @default(cuid())
  householdId String
  moduleId    String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, moduleId])
}

// --- FinancialOS -----------------------------------------------------------
// The most sensitive data in LifeOS. Three rules hold across every model here:
//
//   1. Money is stored as INTEGER CENTS (`...Cents`), never floats. Exact
//      arithmetic, no decimal library. Int caps a single row at ~$21.4M, which
//      is the documented ceiling for a household app; aggregates are summed in
//      JS numbers (exact to 2^53 cents).
//   2. Nothing here is readable by a CHILD or GUEST member. That gate lives in
//      src/lib/financialos/authz.ts and every route calls it — the entitlement
//      check alone is NOT sufficient for this module (see DESIGN.md).
//   3. Provider secrets (Plaid access tokens) are never stored in plaintext.
//      PlaidItem.accessTokenEnc holds an AES-256-GCM envelope produced by
//      src/lib/financialos/crypto.ts.

// Household-level tax + planning facts. One row per household. Everything the
// advice engine needs that isn't derivable from accounts/transactions.
model FinancialProfile {
  id          String @id @default(cuid())
  householdId String @unique

  filingStatus String @default("MARRIED_JOINT") // SINGLE | MARRIED_JOINT | MARRIED_SEPARATE | HEAD_OF_HOUSEHOLD
  stateCode    String @default("CA") // 2-letter; drives state income tax + 529 deduction rules

  // Self-reported context the engine can't infer from bank data.
  emergencyFundMonthsTarget Int     @default(6)
  riskTolerance             String  @default("MODERATE") // CONSERVATIVE | MODERATE | AGGRESSIVE
  financialLiteracy         String  @default("BEGINNER") // BEGINNER | LEARNING | CONFIDENT — drives how much explaining the UI does
  hasWill                   Boolean @default(false)
  hasEstateBeneficiaries    Boolean @default(false)

  // Debt facts that outrank investing in the waterfall but don't always show
  // up as linked accounts (student loans at a servicer, family loans, etc).
  highInterestDebtCents Int   @default(0)
  highInterestDebtApr   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// Per-earning-adult employment + workplace-plan facts. The Backdoor Roth and
// especially the Mega Backdoor Roth recommendations are entirely gated on
// plan features (after-tax contributions + in-plan conversion or in-service
// withdrawal), so those are explicit fields rather than assumptions.
model EarnerProfile {
  id       String @id @default(cuid())
  memberId String @unique

  annualSalaryCents Int     @default(0)
  annualBonusCents  Int     @default(0)
  selfEmployed      Boolean @default(false)

  // Workplace retirement plan
  hasWorkplacePlan          Boolean @default(false)
  planType                  String  @default("401K") // 401K | 403B | 457B | SIMPLE_IRA | SEP_IRA | SOLO_401K | NONE
  employerMatchPercent      Float   @default(0) // employer matches this % of pay contributed...
  employerMatchLimitPercent Float   @default(0) // ...up to this % of pay
  currentDeferralPercent    Float   @default(0)
  currentDeferralIsRoth     Boolean @default(false)
  planAllowsAfterTax        Boolean @default(false) // the Mega Backdoor precondition
  planAllowsInPlanRoth      Boolean @default(false) // in-plan Roth conversion
  planAllowsInServiceW      Boolean @default(false) // in-service withdrawal to Roth IRA
  employerContribCents      Int     @default(0) // non-elective/profit sharing, counts toward 415(c)

  // IRA facts (needed for the pro-rata rule — a pre-tax IRA balance is what
  // makes a Backdoor Roth expensive, so we ask instead of guessing).
  traditionalIraBalanceCents Int @default(0)
  currentIraContribCents     Int @default(0)

  // HSA facts
  hsaEligible             Boolean @default(false)
  hsaCoverage             String  @default("NONE") // NONE | SELF | FAMILY
  currentHsaContribCents  Int     @default(0)
  employerHsaContribCents Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// A linked Plaid Item = one institution login. Access token is encrypted.
model PlaidItem {
  id          String @id @default(cuid())
  householdId String
  itemId      String @unique

  accessTokenEnc  String // "v1:<iv-b64>:<tag-b64>:<ciphertext-b64>" — see crypto.ts
  institutionId   String?
  institutionName String?

  status           String    @default("GOOD") // GOOD | LOGIN_REQUIRED | PENDING_EXPIRATION | ERROR | REVOKED
  statusDetail     String?
  cursor           String? // /transactions/sync cursor — null means "never synced"
  lastSyncedAt     DateTime?
  consentExpiresAt DateTime?

  linkedByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accounts  FinancialAccount[]

  @@index([householdId])
}

model FinancialAccount {
  id          String  @id @default(cuid())
  householdId String
  plaidItemId String?

  plaidAccountId String? @unique
  name           String
  officialName   String?
  mask           String? // last 4 only — full account numbers are never stored
  type           String // DEPOSITORY | CREDIT | LOAN | INVESTMENT | OTHER
  subtype        String?

  currentBalanceCents   Int    @default(0)
  availableBalanceCents Int?
  limitCents            Int?
  isoCurrency           String @default("USD")

  // Loans/credit carry a rate the debt-payoff rule needs.
  interestRateApr Float?

  isManual          Boolean   @default(false)
  includeInNetWorth Boolean   @default(true)
  ownerMemberId     String?
  visibility        String    @default("HOUSEHOLD") // HOUSEHOLD | OWNER_ONLY
  closedAt          DateTime?
  lastRefreshedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plaidItem    PlaidItem?       @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  ownerMember  HouseholdMember? @relation("AccountOwner", fields: [ownerMemberId], references: [id])
  transactions Transaction[]

  @@index([householdId, type])
}

// SIGN CONVENTION, stated once and enforced at ingest (see sync.ts):
//   amountCents > 0  => money INTO the household (income, refunds, transfers in)
//   amountCents < 0  => money OUT of the household (expenses, transfers out)
// This is the INVERSE of Plaid's convention, which is normalized on the way in.
model Transaction {
  id          String @id @default(cuid())
  householdId String
  accountId   String

  plaidTransactionId String?   @unique
  date               DateTime
  authorizedDate     DateTime?
  name               String
  merchantName       String?
  amountCents        Int
  isoCurrency        String    @default("USD")
  pending            Boolean   @default(false)

  categoryKey      String  @default("uncategorized") // key into src/lib/financialos/categories.ts
  categorySource   String  @default("PLAID") // PLAID | RULE | USER
  plaidPfcPrimary  String?
  plaidPfcDetailed String?

  isTransfer           Boolean @default(false)
  isRecurring          Boolean @default(false)
  recurringKey         String?
  excludedFromCashflow Boolean @default(false)
  notes                String?
  goalId               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  goal      SavingsGoal?     @relation(fields: [goalId], references: [id])

  @@index([householdId, date])
  @@index([accountId, date])
  @@index([householdId, categoryKey])
}

// User-defined "always categorize X as Y" rules. Applied at ingest and
// re-runnable over history. Highest priority wins.
model CategoryRule {
  id          String @id @default(cuid())
  householdId String

  matchField     String  @default("NAME") // NAME | MERCHANT
  matchType      String  @default("CONTAINS") // CONTAINS | EQUALS | STARTS_WITH
  pattern        String
  categoryKey    String
  markAsTransfer Boolean @default(false)
  priority       Int     @default(100)

  createdAt DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, priority])
}

model SavingsGoal {
  id          String @id @default(cuid())
  householdId String

  templateKey              String? // key into src/lib/financialos/goals.ts, null for custom
  name                     String
  kind                     String // EMERGENCY | VACATION | PROPERTY | EDUCATION | VEHICLE | WEDDING | FUNERAL | DEBT_PAYOFF | CUSTOM
  targetCents              Int
  targetDate               DateTime?
  monthlyContributionCents Int       @default(0)
  currentCents             Int       @default(0) // manual ledger; kept in sync with contributions

  linkedAccountId String? // if set, progress reads the account balance instead
  forMemberId     String? // e.g. which child this education goal is for
  priority        Int     @default(100)
  status          String  @default("ACTIVE") // ACTIVE | PAUSED | COMPLETE
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  forMember     HouseholdMember?   @relation("GoalForMember", fields: [forMemberId], references: [id])
  contributions GoalContribution[]
  transactions  Transaction[]

  @@index([householdId, status])
}

model GoalContribution {
  id            String   @id @default(cuid())
  goalId        String
  amountCents   Int
  occurredAt    DateTime @default(now())
  source        String   @default("MANUAL") // MANUAL | TRANSACTION
  transactionId String?
  note          String?

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, occurredAt])
}

model InsurancePolicy {
  id          String  @id @default(cuid())
  householdId String
  memberId    String?

  type               String // TERM_LIFE | WHOLE_LIFE | UNIVERSAL_LIFE | DISABILITY | UMBRELLA
  carrier            String?
  coverageCents      Int       @default(0)
  annualPremiumCents Int       @default(0)
  termYears          Int?
  startDate          DateTime?
  endDate            DateTime?
  beneficiary        String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation("PolicyMember", fields: [memberId], references: [id])

  @@index([householdId])
}

// The advice engine is deterministic, so a snapshot is a cache, not a source
// of truth — it exists so the UI is fast and so you can see what was
// recommended (and on what inputs) at a point in time.
model RecommendationSnapshot {
  id            String   @id @default(cuid())
  householdId   String
  engineVersion String
  inputHash     String
  payload       Json
  generatedAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, generatedAt])
}

// LLM-written plain-English copy for a given (rule, inputs) pair. Cached so
// the same situation always reads the same way and we don't pay per render.
// The rules decide WHAT to recommend; this only rewrites the WHY.
model ExplanationCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique // sha256(ruleId + engineVersion + salient inputs)
  ruleId    String
  text      String
  model     String
  createdAt DateTime @default(now())
}

// Every read and write of financial data, appended. Deliberately separate
// from application logs: this one is queryable, householdscoped, and never
// contains account numbers or dollar amounts.
model FinancialAuditLog {
  id          String   @id @default(cuid())
  householdId String
  actorUserId String?
  action      String // VIEW_OVERVIEW | VIEW_TRANSACTIONS | LINK_ITEM | SYNC | UPDATE_PROFILE | ...
  resource    String? // ACCOUNT | TRANSACTION | GOAL | ITEM | PROFILE
  resourceId  String?
  outcome     String   @default("OK") // OK | DENIED | ERROR
  meta        Json?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
}

// --- TravelOS ---------------------------------------------------------------
// Plan trips around when the family can actually go.
//
// The chain is: school calendar -> no-school days -> contiguous breaks ->
// windows the whole household can travel in -> destinations that suit that
// window -> real flight prices -> a human confirms -> a trip and a funded
// savings goal.
//
// Two rules hold throughout:
//
//   1. Nothing extracted from a PDF is trusted until a human confirms it. A
//      calendar sits in DRAFT with per-entry confidence until someone reviews
//      it; a misread date silently corrupts every downstream suggestion.
//   2. Flight prices are cached, not live, and carry the timestamp they were
//      seen at. Presenting a stale price as live is the one thing that would
//      make this feature untrustworthy.

model TravelPreferences {
  id          String @id @default(cuid())
  householdId String @unique

  homeAirport      String? // IATA, e.g. "SFO" — the origin for every search
  maxFlightHours   Int     @default(6)
  domesticOnly     Boolean @default(false)
  passportsReady   Boolean @default(false)
  budgetPerTripCents Int   @default(0)
  preferredStyles  String? // CSV of DestinationStyle keys, e.g. "BEACH,NATURE"
  currency         String  @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// One uploaded school calendar. Shared across siblings at the same school via
// the join table rather than duplicated per child.
model SchoolCalendar {
  id          String @id @default(cuid())
  householdId String

  name       String
  schoolName String?
  sourceType String // ICS | CSV | PDF | IMAGE | MANUAL
  sourceFileName String?
  schoolYearStart DateTime?
  schoolYearEnd   DateTime?

  // DRAFT until a human has reviewed the extracted dates. Only CONFIRMED
  // calendars feed the window engine.
  status String @default("DRAFT")

  // Provenance for anything a model extracted, so a bad parse is traceable.
  extractionModel String?
  extractionNotes String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   SchoolCalendarEntry[]
  children  SchoolCalendarChild[]

  @@index([householdId, status])
}

model SchoolCalendarChild {
  id         String @id @default(cuid())
  calendarId String
  childId    String

  calendar SchoolCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  child    HouseholdMember @relation("CalendarChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([calendarId, childId])
}

model SchoolCalendarEntry {
  id         String @id @default(cuid())
  calendarId String

  startDate DateTime
  endDate   DateTime
  title     String
  kind      String // BREAK | HOLIDAY | TEACHER_DAY | EARLY_RELEASE | FIRST_DAY | LAST_DAY | OTHER
  noSchool  Boolean @default(true)

  // Extraction provenance. `confidence` is only meaningful for LLM source.
  source     String  @default("PARSED") // PARSED | LLM | MANUAL
  confidence Float?
  confirmed  Boolean @default(false)
  rawText    String?

  createdAt DateTime @default(now())

  calendar SchoolCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, startDate])
}

// Per-adult travel availability. School breaks alone don't determine when a
// family can go — someone has to be able to take the time off.
model TravelAvailability {
  id       String @id @default(cuid())
  memberId String @unique

  ptoDaysPerYear   Int @default(15)
  ptoDaysRemaining Int @default(15)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member HouseholdMember @relation("TravelAvailability", fields: [memberId], references: [id], onDelete: Cascade)
}

model BlackoutPeriod {
  id          String @id @default(cuid())
  householdId String
  memberId    String?

  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation("BlackoutMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId, startDate])
}

// A stretch of time the whole household could travel. Regenerated from the
// calendars on demand — a cache of the engine's output, not a source of truth,
// except for `status`, which is the human's decision and survives regeneration.
model TravelWindow {
  id          String @id @default(cuid())
  householdId String

  label     String
  startDate DateTime
  endDate   DateTime

  totalDays        Int
  schoolDaysMissed Int @default(0)
  ptoDaysRequired  Int @default(0)

  score           Float   @default(0)
  seasonLabel     String? // PEAK | SHOULDER | OFF_PEAK
  reasons         Json?
  conflicts       Json?

  status String @default("SUGGESTED") // SUGGESTED | SHORTLISTED | CONFIRMED | DISMISSED

  engineVersion String?
  generatedAt   DateTime @default(now())

  household    Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  flightOptions FlightOption[]
  trips        Trip[]

  @@unique([householdId, startDate, endDate])
  @@index([householdId, status])
}

// A concrete flight option shown to the user. Stored with the price's
// observation time and a booking link — LifeOS never books anything itself.
model FlightOption {
  id       String  @id @default(cuid())
  windowId String?
  tripId   String?

  origin      String
  destination String
  destinationName String?

  departAt DateTime
  returnAt DateTime?

  priceCents Int
  currency   String @default("USD")

  airline        String?
  flightNumber   String?
  transfers      Int     @default(0)
  durationMinutes Int?

  bookingUrl  String?
  provider    String   @default("TRAVELPAYOUTS")
  priceSeenAt DateTime // when the provider last observed this fare
  fetchedAt   DateTime @default(now())
  rank        Int      @default(0)

  window TravelWindow? @relation(fields: [windowId], references: [id], onDelete: Cascade)
  trip   Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([windowId, rank])
}

// A window a human confirmed, with a destination chosen.
model Trip {
  id          String @id @default(cuid())
  householdId String
  windowId    String?

  name            String
  destinationCode String? // IATA
  destinationName String?
  startDate       DateTime
  endDate         DateTime

  status String @default("PLANNING") // PLANNING | BOOKED | COMPLETED | CANCELLED

  estimatedCostCents Int @default(0)
  // The FinancialOS savings goal funding this trip. A plain id, not a
  // relation into FinancialOS internals — the modules stay decoupled and
  // TravelOS goes through src/lib/travelos/integrations.ts to touch it.
  savingsGoalId String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  window    TravelWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  flights   FlightOption[]

  @@index([householdId, startDate])
}

// --- PropertyOS -------------------------------------------------------------
// Running a house: the bills that must be paid, the maintenance that must
// happen, the people who do it, and the equipment it happens to.
//
// The organising idea is that a house generates two streams of obligation —
// money out on a schedule, and work on a schedule — and both are easy to
// forget until something breaks or a penalty lands. Everything here exists to
// make the next 30 days visible.
//
// Money is integer cents, same as FinancialOS. Dates are calendar days, same
// as TravelOS (via travelos/dates.ts — deliberately reused rather than
// reimplemented, since off-by-one-day bugs cost real money here too).

model Property {
  id          String @id @default(cuid())
  householdId String

  name         String  @default("Home")
  addressLine  String?
  city         String?
  stateCode    String  @default("CA")
  postalCode   String?
  propertyType String  @default("SINGLE_FAMILY") // SINGLE_FAMILY | CONDO | TOWNHOME | MULTI_FAMILY | OTHER

  yearBuilt   Int?
  squareFeet  Int?
  purchaseDate       DateTime?
  purchasePriceCents Int?

  // Used to estimate the property tax bill when you haven't entered one.
  assessedValueCents Int?
  taxRatePercent     Float? // e.g. 1.25 for a 1.25% effective rate

  // Facts that change which maintenance tasks apply and how often.
  hasWaterSoftener Boolean @default(false)
  hasIrrigation    Boolean @default(false)
  hasPool          Boolean @default(false)
  hasSepticTank    Boolean @default(false)
  hasFireplace     Boolean @default(false)
  hardWater        Boolean @default(false)
  dustyOrSmoky     Boolean @default(false) // wildfire smoke, desert dust, nearby construction
  heavyTreeCover   Boolean @default(false) // drives gutter frequency

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  bills     PropertyBill[]
  tasks     MaintenanceTask[]
  equipment Equipment[]

  @@index([householdId])
}

// A recurring obligation to pay. Either entered by hand or adopted from a
// recurring charge FinancialOS already detected in the transaction feed.
model PropertyBill {
  id          String @id @default(cuid())
  propertyId  String
  householdId String

  name     String
  category String // PROPERTY_TAX | ELECTRIC | GAS | WATER | SEWER | TRASH | INTERNET | INSURANCE | HOA | WARRANTY | LANDSCAPING | PEST | SECURITY | OTHER
  vendorId String?

  cadence String @default("MONTHLY") // MONTHLY | BIMONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL | SPLIT_SEMIANNUAL | ONE_TIME
  typicalAmountCents Int @default(0)
  dueDayOfMonth      Int? // 1-31, for cadences anchored to a day
  nextDueDate        DateTime?
  autopay            Boolean @default(false)

  // Set when this bill was adopted from a detected recurring transaction —
  // the normalized merchant key from financialos/categorize.ts. Keeping it
  // means we don't re-suggest a bill the user already tracks.
  detectedKey String?

  lastPaidAt    DateTime?
  lastPaidCents Int?

  status String  @default("ACTIVE") // ACTIVE | PAUSED | CLOSED
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  vendor    Vendor?        @relation(fields: [vendorId], references: [id])
  payments  BillPayment[]

  @@index([householdId, nextDueDate])
  @@index([propertyId, status])
}

model BillPayment {
  id     String @id @default(cuid())
  billId String

  amountCents Int
  paidOn      DateTime
  source      String  @default("MANUAL") // MANUAL | TRANSACTION
  transactionId String? // FinancialOS Transaction id, when matched
  note        String?

  createdAt DateTime @default(now())

  bill PropertyBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, paidOn])
}

// A recurring job. The interval is the point: "every 90 days from when it was
// last actually done", not "the first of every quarter".
model MaintenanceTask {
  id          String @id @default(cuid())
  propertyId  String
  householdId String

  templateKey String? // key into src/lib/propertyos/catalog.ts, null for custom
  name        String
  category    String // HVAC | WATER | EXTERIOR | SAFETY | APPLIANCE | LANDSCAPE | PLUMBING | ELECTRICAL | IOT | OTHER
  priority    String @default("ROUTINE") // CRITICAL | IMPORTANT | ROUTINE

  intervalDays    Int
  lastCompletedAt DateTime?
  nextDueDate     DateTime

  // Seasonal tasks shouldn't drift: "clean gutters before the rains" is a
  // month, not an interval. CSV of months 1-12; empty means interval-driven.
  seasonalMonths String?

  equipmentId String?
  vendorId    String?
  diy         Boolean @default(true)
  estimatedCostCents Int @default(0)
  estimatedMinutes   Int @default(0)

  status String  @default("ACTIVE") // ACTIVE | SNOOZED | ARCHIVED
  snoozedUntil DateTime?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  equipment Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  vendor    Vendor?           @relation(fields: [vendorId], references: [id])
  logs      MaintenanceLog[]

  @@index([householdId, nextDueDate])
  @@index([propertyId, status])
}

model MaintenanceLog {
  id     String @id @default(cuid())
  taskId String

  completedAt DateTime
  costCents   Int      @default(0)
  vendorId    String?
  notes       String?

  createdAt DateTime @default(now())

  task   MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  vendor Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([taskId, completedAt])
}

// The gardener, the plumber, the handyman. Worth keeping because the hardest
// part of a home repair is remembering who did it well last time.
model Vendor {
  id          String @id @default(cuid())
  householdId String

  name  String
  trade String // GARDENER | PLUMBER | HANDYMAN | ELECTRICIAN | HVAC | PEST | CLEANER | ROOFER | POOL | APPLIANCE | OTHER

  phone   String?
  email   String?
  website String?
  hourlyRateCents Int?
  rating  Int? // 1-5
  notes   String?

  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  bills     PropertyBill[]
  tasks     MaintenanceTask[]
  logs      MaintenanceLog[]

  @@index([householdId, trade])
}

// Everything in the house that has a model number, a warranty, or a filter —
// including IoT devices, which are just equipment with batteries and firmware.
model Equipment {
  id          String @id @default(cuid())
  propertyId  String
  householdId String

  name String
  kind String // HVAC | WATER_HEATER | SOFTENER | RO_FILTER | REFRIGERATOR | WASHER | DRYER | DISHWASHER | GARAGE_DOOR | SOLAR | THERMOSTAT | CAMERA | DOORBELL | SENSOR | HUB | SMOKE_DETECTOR | SPRINKLER | OTHER
  isIot Boolean @default(false)

  brand        String?
  model        String?
  serialNumber String?

  installedOn        DateTime?
  warrantyExpiresOn  DateTime?
  expectedLifeYears  Int?

  // The two things you can never find when you need them.
  filterSize  String?
  batteryType String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property  Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     MaintenanceTask[]

  @@index([householdId, kind])
}

// --- DayOS -----------------------------------------------------------------
// Who is doing what today, and when they need to leave.
//
// The other modules answer questions about a horizon: a quarter of bills, a
// year of maintenance, a school break nine months out. This one answers the
// next four hours, and that changes what the schema has to be good at.
//
// Four rules hold across everything below:
//
//   1. A recurring activity stores a WALL-CLOCK TIME (`startMinute`, minutes
//      since local midnight) and a set of weekdays — never an instant. "Dance
//      at 5 PM every Tuesday" has to survive a daylight-saving change, and an
//      instant does not. The instant is resolved per occurrence, in the
//      household's zone, by src/lib/dayos/time.ts.
//   2. An ActivityOccurrence is MATERIALIZED, one row per activity per day. It
//      would be cheaper to compute the day on the fly, but an occurrence is
//      where a human decision lands — who confirmed, who covered, what was
//      sent — and those cannot live in a projection that gets recomputed.
//   3. Anyone who can be responsible for something is either a HouseholdMember
//      or an ExternalContact. The other parents in a carpool are real
//      participants in the plan; refusing to model them because they don't
//      have a LifeOS login would make the carpool feature useless. Every
//      assignment field is therefore a nullable pair, exactly one of which is
//      set — enforced in src/lib/dayos/service.ts, since Prisma has no
//      check constraints.
//   4. Every outbound message is recorded in NotificationDispatch BEFORE the
//      send is attempted, keyed uniquely. A worker that ticks every minute and
//      crashes mid-send must not be able to send the same "drive now" twice.

// Household-level DayOS settings. The time zone lives here rather than on User
// because a household's day is a single shared thing — the 3:15 pickup is at
// 3:15 for both parents even when one of them is travelling.
model DayPreferences {
  id          String @id @default(cuid())
  householdId String @unique

  // IANA zone, e.g. "America/Los_Angeles". Every wall-clock time in this
  // module is interpreted in it.
  timeZone String @default("America/Los_Angeles")

  morningBriefMinute Int     @default(420) // 07:00 local
  eveningBriefMinute Int?    // null = off
  briefEnabled       Boolean @default(true)

  // Defaults applied to new activities; each activity can override.
  defaultArrivalBufferMinutes Int @default(10)
  defaultPrepMinutes          Int @default(10)

  // Confirmation ladder timings, in minutes before departure.
  askLeadMinutes       Int @default(120)
  remindLeadMinutes    Int @default(45)
  escalateLeadMinutes  Int @default(25)
  uncoveredLeadMinutes Int @default(10)

  // Off by default: proactive messages are the module's whole value AND its
  // whole risk, so a household opts in rather than discovering it at 6 AM.
  proactiveEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

// Per-adult facts the origin inference needs. Separate from HouseholdMember so
// the shared member row stays module-neutral.
model MemberDayProfile {
  id       String @id @default(cuid())
  memberId String @unique

  homePlaceId String?
  workPlaceId String?

  // CSV of weekday digits, Sunday = 0.
  workWeekdays     String @default("1,2,3,4,5")
  workStartMinute  Int    @default(540)  // 09:00
  workEndMinute    Int    @default(1020) // 17:00

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member    HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  homePlace Place?          @relation("ProfileHome", fields: [homePlaceId], references: [id], onDelete: SetNull)
  workPlace Place?          @relation("ProfileWork", fields: [workPlaceId], references: [id], onDelete: SetNull)
}

// A named location. Calendar events carry free-text locations; a Place is the
// resolved, reusable version with a geocode, so travel time isn't re-derived
// from a string every five minutes.
model Place {
  id          String @id @default(cuid())
  householdId String

  label   String
  kind    String  @default("CUSTOM") // HOME | WORK | SCHOOL | ACTIVITY | MEDICAL | CUSTOM
  address String

  // Provider place id + geocode, cached after the first resolution.
  providerPlaceId String?
  latitude        Float?
  longitude       Float?

  // Extra minutes this specific place costs on arrival — the school pickup
  // line, hospital parking. Added to the activity's arrival buffer.
  parkingBufferMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household        Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activities       Activity[]           @relation("ActivityPlace")
  activityOrigins  Activity[]           @relation("ActivityOrigin")
  occurrenceOrigins ActivityOccurrence[] @relation("OccurrenceOrigin")
  profileHomes     MemberDayProfile[]   @relation("ProfileHome")
  profileWorks     MemberDayProfile[]   @relation("ProfileWork")

  @@index([householdId, kind])
}

// Someone outside the household who takes turns or needs to be told: the other
// carpool parents, a grandparent, a babysitter.
model ExternalContact {
  id          String @id @default(cuid())
  householdId String

  name         String
  relationship String? // CARPOOL_PARENT | GRANDPARENT | SITTER | COACH | OTHER

  channel        String  @default("NONE") // SMS | WHATSAPP | TELEGRAM | EMAIL | NONE
  channelAddress String?
  phone          String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household        Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  groupMemberships CoordinationGroupMember[]
  rotationSlots    RotationSlot[]
  occurrences      ActivityOccurrence[]      @relation("OccurrenceResponsibleContact")
  overridesAs      AssignmentOverride[]      @relation("OverrideAssigneeContact")

  @@index([householdId])
}

// Where a member can actually be reached. A household member with no channel
// gets in-app only — which the UI says out loud, because a reminder nobody
// receives is the failure this module is supposed to prevent.
model MemberChannel {
  id       String @id @default(cuid())
  memberId String

  channel String // TELEGRAM | WHATSAPP | SMS | EMAIL | PUSH | IN_APP
  address String // chat id, phone number, email — whatever the driver needs

  isPrimary Boolean @default(false)
  verified  Boolean @default(false)
  // Quiet hours, local minutes. Non-urgent sends wait; a DRIVE_NOW never does.
  quietFromMinute Int?
  quietToMinute   Int?

  createdAt DateTime @default(now())

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, channel])
  @@index([memberId, isPrimary])
}

// A carpool, a class parent group, the family itself.
model CoordinationGroup {
  id          String @id @default(cuid())
  householdId String

  name String
  kind String @default("CARPOOL") // CARPOOL | FAMILY | CLASS | OTHER

  // Where this group is broadcast to, as a GROUP rather than as N people.
  // WHATSAPP addresses are the Baileys JID ("...@g.us"); TELEGRAM is the
  // numeric chat id (negative for groups). NONE means the group exists for
  // rostering only and nothing is ever posted to it.
  channel        String  @default("NONE") // WHATSAPP | TELEGRAM | SMS | NONE
  channelAddress String?

  // A group post carries no leave times or addresses — only who has the run
  // and at what time. The other families are not household members and have
  // not consented to LifeOS knowing where they are.
  broadcastEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members   CoordinationGroupMember[]
  rotations Rotation[]

  @@index([householdId])
}

model CoordinationGroupMember {
  id      String @id @default(cuid())
  groupId String

  memberId  String?
  contactId String?

  orderIndex Int @default(0)

  group   CoordinationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member  HouseholdMember?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contact ExternalContact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([groupId, orderIndex])
}

// Whose turn it is. See src/lib/dayos/rotation.ts for why FIXED_WEEKDAY and
// ROUND_ROBIN are the only two kinds.
model Rotation {
  id          String @id @default(cuid())
  householdId String
  groupId     String?

  name String
  kind String @default("FIXED_WEEKDAY") // FIXED_WEEKDAY | ROUND_ROBIN

  // ROUND_ROBIN counts occurrences from here. Changing it re-phases the whole
  // rota, so the UI treats it as a destructive edit.
  anchorDay DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household  Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group      CoordinationGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slots      RotationSlot[]
  activities Activity[]
  overrides  AssignmentOverride[]

  @@index([householdId])
}

model RotationSlot {
  id         String @id @default(cuid())
  rotationId String

  // Set for FIXED_WEEKDAY (Sunday = 0); ignored for ROUND_ROBIN.
  weekday    Int?
  orderIndex Int @default(0)

  memberId  String?
  contactId String?

  rotation Rotation         @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  member   HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contact  ExternalContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([rotationId, orderIndex])
}

// A one-day change to the rota. COVER is one-directional and creates a debt;
// SWAP is written as two rows that exchange two dates and nets to zero. The
// distinction is the whole reason this table exists rather than a nullable
// override column on the occurrence.
model AssignmentOverride {
  id         String @id @default(cuid())
  rotationId String

  day  DateTime // UTC midnight — a calendar day
  kind String   @default("COVER") // COVER | SWAP

  assigneeMemberId  String?
  assigneeContactId String?

  // Who the roster had. Kept so fairness stays computable after the fact.
  replacedMemberId  String?
  replacedContactId String?

  swappedWithDay DateTime?
  note           String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  rotation        Rotation         @relation(fields: [rotationId], references: [id], onDelete: Cascade)
  assigneeMember  HouseholdMember? @relation("OverrideAssignee", fields: [assigneeMemberId], references: [id], onDelete: Cascade)
  assigneeContact ExternalContact? @relation("OverrideAssigneeContact", fields: [assigneeContactId], references: [id], onDelete: Cascade)
  replacedMember  HouseholdMember? @relation("OverrideReplaced", fields: [replacedMemberId], references: [id], onDelete: SetNull)

  @@unique([rotationId, day])
  @@index([rotationId, day])
}

// The recurring thing itself: school pickup, dance, Kumon, the commute.
model Activity {
  id          String @id @default(cuid())
  householdId String

  name     String
  category String @default("OTHER") // SCHOOL | CLASS | SPORT | MEDICAL | ERRAND | COMMUTE | RELIGIOUS | SOCIAL | OTHER

  // Who it's FOR. Null for an adult's own commitment.
  subjectMemberId String?

  placeId       String?
  // Pin the starting point instead of inferring it (see origin.ts).
  originPlaceId String?

  // Wall-clock minutes since local midnight. NOT an instant — see the header.
  startMinute     Int
  durationMinutes Int?

  // CSV of weekday digits, Sunday = 0. Empty means a single-date activity.
  weekdays       String   @default("")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  schoolDaysOnly Boolean  @default(false)

  travelRequired       Boolean @default(true)
  arrivalBufferMinutes Int?
  prepMinutes          Int?

  // Exactly one assignment source: a fixed person, or a rotation.
  defaultResponsibleMemberId String?
  rotationId                 String?

  requiresConfirmation Boolean @default(false)
  // CSV of channels to use, empty means each recipient's primary.
  notifyChannels String  @default("")
  notifyGroup    Boolean @default(false)

  // DROPOFF | PICKUP for a school run that a carpool group shares. Explicit
  // rather than sniffed from the name: this string decides how the run is
  // labelled in a message sent to four other families, and "Pickup 8:00 AM"
  // because somebody renamed an activity is a wasted trip.
  carpoolRole String?

  status String @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED

  // Provenance, so a calendar-derived activity can be re-synced and a
  // hand-made one is never clobbered by an import.
  source          String  @default("MANUAL") // MANUAL | CALENDAR | AGENT
  externalEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household           Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  subjectMember       HouseholdMember?     @relation("ActivitySubject", fields: [subjectMemberId], references: [id], onDelete: SetNull)
  defaultResponsible  HouseholdMember?     @relation("ActivityDefaultResponsible", fields: [defaultResponsibleMemberId], references: [id], onDelete: SetNull)
  place               Place?               @relation("ActivityPlace", fields: [placeId], references: [id], onDelete: SetNull)
  originPlace         Place?               @relation("ActivityOrigin", fields: [originPlaceId], references: [id], onDelete: SetNull)
  rotation            Rotation?            @relation(fields: [rotationId], references: [id], onDelete: SetNull)
  skips               ActivitySkip[]
  occurrences         ActivityOccurrence[]

  @@index([householdId, status])
  @@unique([householdId, externalEventId])
}

model ActivitySkip {
  id         String @id @default(cuid())
  activityId String

  day    DateTime // UTC midnight
  reason String?

  createdAt DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, day])
}

// One day of one activity. The row a human decision lands on.
model ActivityOccurrence {
  id          String @id @default(cuid())
  householdId String
  activityId  String

  day     DateTime // UTC midnight — the calendar day
  startAt DateTime // the resolved instant
  endAt   DateTime?

  responsibleMemberId  String?
  responsibleContactId String?
  // ROSTER | COVER | SWAP | DEFAULT | MANUAL | UNASSIGNED
  assignmentSource     String  @default("UNASSIGNED")

  originPlaceId    String?
  // CHAINED | SCHEDULE | DEFAULT — never presented as fact when it's a guess.
  originConfidence String?

  travelMinutes      Int?
  leaveAt            DateTime?
  arriveBy           DateTime?
  estimateComputedAt DateTime?
  estimateConverged  Boolean   @default(true)
  retimeAlertsSent   Int       @default(0)

  // The travel time the household was last actually TOLD about this trip, and
  // when. Re-timing compares against this rather than against the last
  // computation: a change nobody heard about is not a change to them. It is a
  // column rather than something re-derived from the message log because the
  // morning brief covers the whole day in one message — there is no per-trip
  // dispatch row to read it back off.
  lastToldTravelMinutes Int?
  lastToldAt            DateTime?

  // SCHEDULED | PREPARE | DRIVE_NOW | RUNNING_LATE | PASSED
  phase String @default("SCHEDULED")
  // NOT_REQUIRED | PENDING | CONFIRMED | DECLINED | REASSIGNED | UNCOVERED
  confirmationState String @default("NOT_REQUIRED")
  confirmedAt       DateTime?
  // CSV of rungs already sent: ASK,REMIND,ESCALATE,BROADCAST,UNCOVERED
  escalationsSent   String @default("")

  status String  @default("PLANNED") // PLANNED | DONE | CANCELLED
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household           Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  activity            Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  responsibleMember   HouseholdMember? @relation("OccurrenceResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  responsibleContact  ExternalContact? @relation("OccurrenceResponsibleContact", fields: [responsibleContactId], references: [id], onDelete: SetNull)
  originPlace         Place?           @relation("OccurrenceOrigin", fields: [originPlaceId], references: [id], onDelete: SetNull)
  dispatches          NotificationDispatch[]

  @@unique([activityId, day])
  @@index([householdId, day])
  @@index([householdId, leaveAt])
}

// Cached routing results. Keyed by origin, destination and a 15-minute
// departure bucket on a given weekday, because traffic at 4:15 PM on a Tuesday
// is a stable fact and asking a paid API for it every five minutes is not.
model TravelEstimate {
  id          String @id @default(cuid())
  householdId String

  originKey      String // place id, or a hash of the address
  destinationKey String

  weekday          Int // Sunday = 0
  departureBucket  Int // minutes since local midnight, rounded down to 15

  minutes  Int
  provider String @default("GOOGLE") // GOOGLE | MOCK
  // How the number was obtained. LIVE is a real call for this bucket; TYPICAL
  // is a same-bucket reading from an earlier day, reused rather than re-paid
  // for. The UI never presents TYPICAL as current traffic.
  quality  String @default("LIVE") // LIVE | TYPICAL

  observedAt DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, originKey, destinationKey, weekday, departureBucket])
  @@index([householdId, observedAt])
}

// Written BEFORE the send is attempted, with a unique key, so a worker that
// crashes mid-tick cannot send the same "drive now" twice.
model NotificationDispatch {
  id           String @id @default(cuid())
  occurrenceId String

  // BRIEF | PREPARE | DRIVE_NOW | RETIME | ASK | REMIND | ESCALATE | BROADCAST | UNCOVERED
  kind      String
  channel   String
  recipient String // member id or contact id, prefixed

  status String  @default("PENDING") // PENDING | SENT | FAILED | SUPPRESSED
  detail String?
  body   String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  occurrence ActivityOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, kind, recipient])
  @@index([occurrenceId, createdAt])
}


// Which proactive messages a person wants, independent of WHERE they go.
//
// Split from MemberChannel deliberately: "I want the morning brief" is a fact
// about a person, not about a phone number. Someone who swaps their WhatsApp
// number keeps their preferences; someone who adds SMS as a second channel
// does not get asked all over again what they want on it.
//
// Everything defaults ON except the news brief. The two that default on are
// the ones a person set this module up FOR — a brief they never see and a
// departure alert that never fires are both silent failures. A daily news
// digest is a nice-to-have, and opt-out is the wrong default for those.
model MemberNotificationPrefs {
  id       String @id @default(cuid())
  memberId String @unique

  // The day's schedule, at the household's morning brief time.
  calendarBrief Boolean @default(true)
  // "Leave in 12 minutes." The reason DayOS exists.
  leaveNowAlerts Boolean @default(true)
  // AI headlines digest, generated by the FastAPI LifeOS.
  aiNewsBrief Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// Messages waiting to go out over WhatsApp.
//
// This table exists because of a hard constraint, not a preference: the
// WhatsApp session is a paired device living inside the OpenClaw gateway, and
// the gateway exposes no HTTP send API — only /v1/chat/completions and
// /v1/responses, both of which run an agent. So no web server can push a
// WhatsApp message. The gateway has to PULL.
//
// Both apps write here (DayOS directly, the FastAPI LifeOS over HTTP) and a
// per-minute cron in the gateway drains it with `openclaw message send`.
//
// dedupeKey is what makes a retry safe. A crash between "sent" and "marked
// sent" is the normal failure, and re-sending "leave now" teaches people the
// alerts are noise — so the key is unique and claiming a row is a conditional
// update, not a read-then-write.
model WhatsappOutbox {
  id String @id @default(cuid())

  // E.164 for a person ("+14155550100"), or a "...@g.us" group id.
  toAddress String
  body      String

  // BRIEF | AI_NEWS | DRIVE_NOW | PREPARE | RETIME | ASK | REMIND | ESCALATE |
  // UNCOVERED | CARPOOL — carried through so a drain failure can be read.
  kind String @default("BRIEF")
  // Urgent kinds ignore quiet hours and jump the queue.
  urgent Boolean @default(false)

  // Stable per logical message. "brief:<memberId>:2026-08-24" is sent once
  // even if the scheduler runs twice.
  dedupeKey String @unique

  // PENDING | CLAIMED | SENT | FAILED | EXPIRED
  status String @default("PENDING")
  // Claimed rows that are never acked are released back to PENDING after a
  // grace period, so a gateway crash mid-drain does not strand a message.
  claimedAt DateTime?
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?

  // A departure alert is worthless late. Past this instant the drain drops it
  // rather than telling somebody at 09:10 to leave at 08:45.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([status, urgent, createdAt])
}
